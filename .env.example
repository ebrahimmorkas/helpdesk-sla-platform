APP_NAME="Helpdesk SLA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostnames below match the docker-compose service names.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=laravel
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
FORWARD_DB_PORT=33062

SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=failover

CACHE_STORE=failover
CACHE_PREFIX=helpdesk-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@helpdesk.test"
MAIL_FROM_NAME="${APP_NAME}"


# Personal access token lifetime in minutes (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080

# Password for accounts created by DemoDataSeeder (local only).
# Leave empty to generate a random one that is printed when seeding.
DEMO_USER_PASSWORD=
